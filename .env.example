# ============================================
# OlimpX Environment Configuration
# ============================================
# Bu faylni .env nomi bilan saqlang va o'z qiymatlari bilan to'ldiring.
# Docker uchun DATABASE_URL da host=db bo'lishi kerak (localhost emas!)

# --- Database ---
# Docker uchun: host=db (docker service name)
DATABASE_URL="postgresql://postgres:yourpassword@db:5432/olimpx?schema=public"

# PostgreSQL parol (DATABASE_URL dagi parol bilan bir xil bo'lishi SHART)
POSTGRES_PASSWORD="yourpassword"
POSTGRES_USER="postgres"
POSTGRES_DB="olimpx"

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Security ---
# Kamida 32 ta belgi bo'lishi kerak
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"

# --- Admin ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="SecureAdminPassword123"

# --- Test User (optional, for seed) ---
TEST_EMAIL="test@example.com"
TEST_PASSWORD="SecureTestPassword123"

# --- CORS ---
CORS_ORIGIN="http://localhost:3000"

# --- Redis (optional) ---
REDIS_URL="redis://redis:6379"
REDIS_ENABLED="false"

# --- SSL (optional) ---
DOMAIN="your-domain.com"
SSL_EMAIL="admin@your-domain.com"

{
  "name": "backend",
  "version": "1.0.0",
  "description": "OlimpX Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:setup": "cd .. && prisma generate --schema=backend/prisma/schema.prisma && prisma db push --schema=backend/prisma/schema.prisma && node backend/prisma/seed.js",
    "dev": "npm install --silent && npm run db:setup && nodemon src/server.js",
    "nodemon": "nodemon src/server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "olimpx-root": "file:..",
    "pdfkit": "^0.14.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^6.2.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@jest/globals": "^29.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}

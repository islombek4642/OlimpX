{
  "name": "olimpx-root",
  "version": "1.0.0",
  "description": "OlimpX Fullstack - Root Manager",
  "type": "module",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "node scripts/init.js && npm --prefix backend run nodemon",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "node backend/prisma/seed.js",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "install:all": "npm install && npm --prefix backend install",
    "clean": "rm -rf node_modules backend/node_modules",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "npm --prefix backend test",
    "test:watch": "npm --prefix backend test:watch",
    "test:coverage": "npm --prefix backend test:coverage",
    "backup": "node backend/src/utils/backup.js",
    "backup:create": "node backend/src/utils/backup.js",
    "backup:cleanup": "node -e \"import('./backend/src/utils/backup.js').then(m => m.cleanupOldBackups())\"",
    "backup:stats": "node -e \"import('./backend/src/utils/backup.js').then(m => m.getBackupStats().then(console.log))\"",
    "ssl:validate": "node scripts/ssl-validate.js",
    "ssl:setup": "node scripts/ssl-setup.js",
    "ssl:check": "node scripts/ssl-check.js",
    "ssl:renew": "node scripts/ssl-renew.js",
    "ssl:logs": "sudo tail -f /var/log/olimpx-ssl-renewal.log",
    "docker:ssl": "docker-compose -f docker-compose.ssl.yml up -d"
  },
  "keywords": [],
  "author": "OlimpX Team",
  "license": "ISC"
}
